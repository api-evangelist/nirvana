  "info": {
    "_postman_id": "62174475-db47-453c-b7cf-ce8b6454376b",
    "name": "Nirvana Coverage Cost Estimation Eligibility API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Nirvana's Coverage API verifies a patient's insurance eligibility, estimates their financial responsibility for an appointment, identifies plan-level details that could lead to a denial, and recovers active insurance using only basic demographic information. Responses normalize complex payer data into structured, consistent JSON for behavioral and mental health workflows.\n\nContact Support:\n Name: Nirvana Support",
      "type": "text/plain"
    }
  }
